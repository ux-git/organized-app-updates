{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Organized",
  "version": "../package.json",
  "identifier": "com.sws2apps.organized",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4050",
    "beforeBuildCommand": "npm run build:native",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Organized",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "backgroundColor": "#F8F9FF"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "shortDescription": "Congregation management for Jehovah's Witnesses",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
