<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.organized" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#f8f9ff</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <!-- Splashscreen theme (Android 12 SplashScreen API, backported via core-splashscreen) -->
    <style name="Theme.organized.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#f8f9ff</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.organized</item>
    </style>
</resources>
