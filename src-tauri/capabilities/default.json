{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities every platform needs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "clipboard-manager:allow-write-text",
    "opener:allow-open-path",
    "fs:allow-mkdir",
    "fs:allow-write-file",
    "fs:scope-appcache-recursive"
  ]
}
