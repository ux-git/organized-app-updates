{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Territories",
  "version": "0.1.0",
  "identifier": "com.sws2apps.territories",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4060",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Territories",
        "label": "main",
        "width": 420,
        "height": 860,
        "useHttpsScheme": true,
        "backgroundColor": "#F8F9FF"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    }
  }
}
