{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Territories",
  "version": "0.8.16",
  "identifier": "com.sws2apps.territories",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4060",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Territories: Organized",
        "label": "main",
        "create": false,
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 560,
        "useHttpsScheme": true,
        "backgroundColor": "#F8F9FF"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob: https://tiles.openfreemap.org https://tiles.versatiles.org; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost data: blob: https://tiles.openfreemap.org https://tiles.versatiles.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "16.0",
      "developmentTeam": "9N9L9FKJ3U"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
