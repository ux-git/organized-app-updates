<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.app" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Material 3, so native dialogs (and the WebView's own) are the rounded, current ones -->
        <!-- the web app's default accent (blue) until the page reports its own;
             tints the text selection handles -->
        <item name="colorSecondary">#5065D0</item>
        <item name="colorControlActivated">#5065D0</item>
        <!-- the web app's background, so launch and splash show no flash -->
        <item name="android:windowBackground">#F8F9FF</item>
    </style>

    <!-- Launch theme (AndroidX SplashScreen): the page colour with a small logo,
         held until the web app has drawn its first frame. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F8F9FF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.app</item>
    </style>

    <!-- Fixed light and dark launch themes. On Android 13+ the app picks the one
         matching the page's last colour for the next launch, since the web
         app's theme setting can differ from the system's. -->
    <style name="Theme.App.Starting.Light" parent="Theme.App.Starting">
        <item name="windowSplashScreenBackground">#F8F9FF</item>
    </style>
    <style name="Theme.App.Starting.Dark" parent="Theme.App.Starting">
        <item name="windowSplashScreenBackground">#151519</item>
    </style>
</resources>
