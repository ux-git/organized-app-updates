<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="sync"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_sync">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.sws2apps.territories"
            android:targetClass="com.sws2apps.territories.MainActivity">
            <extra android:name="com.sws2apps.territories.ROUTE" android:value="/nearby?sync=1" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="meet"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_meet">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.sws2apps.territories"
            android:targetClass="com.sws2apps.territories.MainActivity">
            <extra android:name="com.sws2apps.territories.ROUTE" android:value="/nearby" />
        </intent>
    </shortcut>
</shortcuts>
